# העתק את הקובץ הזה ל-.env.local ומלא את הערכים
# .env.local לא נכנס ל-git (מוגדר ב-.gitignore)

# Vercel Blob token לסקריפט gallery:upload
# מגיע מ: Vercel Dashboard → Project → Storage → Blob → .env.local
BLOB_READ_WRITE_TOKEN=

# Instagram (אופציונלי — InstagramWidget פולבק חינני אם ריק)
VITE_INSTAGRAM_ACCESS_TOKEN=
VITE_INSTAGRAM_USER_ID=
VITE_POSTS_TO_SHOW=6
